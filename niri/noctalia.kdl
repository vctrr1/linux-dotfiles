layout {

    focus-ring {
        active-color   "#88d1eb"
        inactive-color "#0f1416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#88d1eb"
        inactive-color "#0f1416"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#88d1eb"
        inactive-color "#004e60"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#88d1eb80"
    }
}

recent-windows {
    highlight {
        active-color "#88d1eb"
        urgent-color "#ffb4ab"
    }
}
