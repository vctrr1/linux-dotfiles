output "DP-2" {
    mode "2560x1080@74.991"
    position x=0 y=0
    scale 1
}

output "DP-3" {
    mode "1920x1080@74.973"
    transform "90"
    position x=-1080 y=-135
    scale 1
}

output "HDMI-A-1" {
    mode "3840x2160@120.000"
    position x=-640 y=-2160
    scale 1
    variable-refresh-rate
}