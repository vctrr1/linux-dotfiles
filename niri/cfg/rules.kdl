// ─────────────────────────────────────────────
// Global Window Appearance
// ─────────────────────────────────────────────
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

// Floating Nautilus window.
window-rule {
  match app-id="org.gnome.Nautilus"
  open-floating true
  // Satura os limites mínimos para permitir janelas bem pequenas
  min-width 0
  min-height 0
  default-column-width { fixed 1080; }
  default-window-height { fixed 600; }
}

//Window Rule to programns like "Open File" and "Save File" dialogs to open floating and with a specific size.
window-rule {
    match title="^Open File$"
    match title="^Abrir Arquivo$"
    match title="^Save File$"
    match title="^Salvar Arquivo$"
    open-floating true
    default-column-width {
        proportion 0.4
    }
    default-window-height {
        proportion 0.6
    }
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

//Firefox download window rule
window-rule {
    match app-id="^firefox$" title="^Biblioteca$"
    open-floating true
    default-column-width { fixed 850; }
    default-window-height { fixed 700; }
}

// Steam normal: monitor vertical
window-rule {
    match app-id="^steam$"
    exclude title="^Steam — Modo Big Picture$"
    open-on-output "DP-3"
    min-width 0
    min-height 0
}

// Steam Big Picture: TV Samsung
window-rule {
    match app-id="^steam$" title="^Steam — Modo Big Picture$"
    open-on-output "HDMI-A-1"
    open-floating false
    open-maximized true
}

// Steam game properties and dialogs open on floating
window-rule {
    match app-id="^steam$"
    exclude title="^Steam$"
    exclude title="^Steam — Modo Big Picture$"
    open-floating true
}

// Calculadora window rule
window-rule {
    match app-id="^org.gnome.Calculator$"
    open-floating true
    default-column-width { fixed 450; }
    default-window-height { fixed 600; }
}
// Frog window rule
window-rule {
    match app-id="com.github.tenderowl.frog"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 600; }
}

// Deadlock window rule, always play on primary monitor
window-rule {
    match app-id="^steam_app_1422450$"
    open-fullscreen true
    open-on-output "DP-2"
}

//Rayman Legend window rule.
window-rule {
    match app-id="^steam_app_242550$" title="^Rayman Legends$"
    open-fullscreen true
}
